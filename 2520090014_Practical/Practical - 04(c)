#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

int main()
{
    pid_t pid;

    pid = fork();

    if (pid < 0)
    {
        printf("Fork failed\n");
        exit(1);
    }

    if (pid == 0)
    {
        // Child process
        printf("Child Process: PID = %d\n", getpid());
        printf("Child is exiting...\n");

        exit(0);
    }
    else
    {
        // Parent process
        printf("Parent Process: PID = %d\n", getpid());

        // Wait for the specific child
        waitpid(pid, NULL, 0);

        printf("Parent: Child process completed and collected.\n");
        printf("Zombie process eliminated.\n");
    }

    return 0;
}

#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>

int main()
{
    pid_t pid;

    pid = fork();

    if (pid < 0)
    {
        printf("Fork failed\n");
        exit(1);
    }

    if (pid == 0)
    {
        // Child process
        printf("Child Process: PID = %d\n", getpid());
        printf("Child is exiting...\n");

        exit(0);
    }
    else
    {
        // Parent process
        printf("Parent Process: PID = %d\n", getpid());
        printf("Parent is sleeping...\n");

        // Parent does not call wait()
        sleep(20);

        printf("Parent is exiting...\n");
    }

    return 0;
}

```c
#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <stdlib.h>

int main()
{
    int fd;

    // Open a file for output
    fd = open("output.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);

    if (fd < 0)
    {
        perror("Error opening file");
        return 1;
    }

    // Redirect standard output to output.txt
    dup2(fd, STDOUT_FILENO);

    close(fd);

    // This output goes into output.txt
    printf("Hello from dup2 redirection!\n");
    printf("Standard output has been redirected to a file.\n");

    return 0;
}

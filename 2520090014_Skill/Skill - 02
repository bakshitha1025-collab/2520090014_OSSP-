include <stdio.h>
#include <string.h>
#include <termios.h>
#include <unistd.h>

#define MAX 100

// Function to read keyboard input character by character
void read_input(char *buffer)
{
    int i = 0;
    char ch;

    while (1)
    {
        ch = getchar();

        // Enter key
        if (ch == '\n')
        {
            buffer[i] = '\0';
            printf("\n");
            break;
        }

        // Backspace key
        else if (ch == 127 || ch == '\b')
        {
            if (i > 0)
            {
                i--;
                printf("\b \b");
                fflush(stdout);
            }
        }

        // Normal character
        else
        {
            if (i < MAX - 1)
            {
                buffer[i] = ch;
                i++;

                printf("%c", ch);
                fflush(stdout);
            }
        }
    }
}

int main()
{
    char input[MAX];

    while (1)
    {
        // Display prompt
        printf("myshell> ");
        fflush(stdout);

        // Read user input
        read_input(input);

        // Check exit condition
        if (strcmp(input, "exit") == 0)
        {
            printf("Program terminated.\n");
            break;
        }

        // Process command
        if (strcmp(input, "hello") == 0)
        {
            printf("Hello! Welcome to the shell.\n");
        }
        else if (strcmp(input, "help") == 0)
        {
            printf("Available commands: hello, help, exit\n");
        }
        else if (strlen(input) == 0)
        {
            printf("No command entered.\n");
        }
        else
        {
            printf("You entered: %s\n", input);
        }
    }

    return 0;
}
